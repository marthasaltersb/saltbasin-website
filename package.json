{
  "name": "saltbasin-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"node --watch server/index.js\"",
    "client": "vite",
    "server": "node --watch server/index.js",
    "build": "vite build",
    "postbuild": "node scripts/run-codex-contribution-intelligence.mjs",
    "contribution:codex": "node scripts/run-codex-contribution-intelligence.mjs",
    "contribution:claude": "node scripts/run-claude-contribution-intelligence.mjs",
    "contribution:import-codex": "node scripts/import-codex-raw-events.mjs",
    "start": "node server/index.js",
    "preview": "vite preview",
    "seed": "node server/data/seed.js",
    "verify:metrics": "node scripts/verify-metric-intelligence.mjs",
    "verify:crystal-orbit": "node scripts/verify-crystal-orbit-chat.mjs",
    "verify:crystal-orbit:live": "node scripts/verify-crystal-orbit-chat.mjs --live",
    "test:crystal-orbit": "node --test tests/crystal-orbit-chat.test.js",
    "scenarios:import": "node scripts/run-scenario-import.mjs",
    "scenarios:validate": "node scripts/validate-scenario-registry.mjs",
    "scenarios:fixture": "node scripts/generate-scenario-fixture.mjs",
    "test:scenarios": "node --test tests/scenarios.test.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.107.0",
    "@vitejs/plugin-react": "^4.3.4",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "node-cron": "^3.0.3",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "recharts": "^3.8.1",
    "three": "^0.185.1",
    "vite": "^6.0.7",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "jest": "^29.7.0",
    "libsodium-wrappers": "^0.8.4"
  }
}
