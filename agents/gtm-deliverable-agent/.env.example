# Get this from console.anthropic.com -- separate from your Claude.ai login.
# Set a monthly spend limit on the API workspace before running this
# unattended for the first time.
ANTHROPIC_API_KEY=

# Where client CSV/XLSX exports live for engagement runs. Point this at a
# path OUTSIDE any git repo, on whatever machine actually runs
# run_engagement.py -- never inside this repo, never through chat upload.
# Defaults to ./secure_input (gitignored) if unset, which is fine for local
# testing with synthetic data but not for real client financials.
GTM_AGENT_CLIENT_DATA_DIR=

# Where generated deliverables land. Defaults to ./output (gitignored) if unset.
GTM_AGENT_OUTPUT_DIR=
